APP_NAME="Inventario TI"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://cgi.alwaysdata.net
APP_TIMEZONE=America/Bogota

DB_HOST=mysql-cgi.alwaysdata.net
DB_PORT=3306
DB_DATABASE=cgi_db01
DB_USERNAME=WLUGO
DB_PASSWORD=CAMBIAR_EN_EL_SERVIDOR
DB_CHARSET=utf8mb4

AUTH_DRIVER=local
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

SESSION_NAME=inventario_ti_session
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
SESSION_MAX_CONCURRENT=2

UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES=5

PRIVATE_STORAGE_PATH=/home/cgi/inventario-ti/storage/private
SESSION_STORAGE_PATH=/home/cgi/inventario-ti/storage/sessions

AUDIT_ONLINE_DAYS=90